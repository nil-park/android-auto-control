# Line endings are decided here, not by each machine's core.autocrlf.
#
# Git for Windows installs with core.autocrlf=true, so a checkout would write
# CRLF while ruff and Prettier write LF, and every format run would leave the
# tree dirty with files whose content diff is empty. Checking out LF matches
# what the formatters produce, on every machine.
* text=auto eol=lf

# cmd.exe can mis-parse a batch file that arrives with LF.
*.bat text eol=crlf
